# ============================================================
# Test files (compiled binaries, not source)
# ============================================================
# Исключаем скомпилированные тесты
test_*
*_test
*_tests

# Но НЕ исключаем исходники тестов
!test_*.cpp
!test_*.c
!test_*.h
!*_test.cpp
!*_test.h
!tests/*.cpp
!tests/*.h

# Исключаем временные файлы тестов
tests/build/
*.gcda
*.gcno
*.gcov
*.log

